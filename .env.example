# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# --- Required ---------------------------------------------------------------
# Signs sessions and encrypts linked-account passwords. Changing it breaks linked accounts.
APP_SECRET=
POSTGRES_PASSWORD=

# Public address people type into the browser (no trailing slash).
# Examples: http://192.168.1.50:8080   or   https://calendar.example.com
BASE_URL=http://localhost:8080

# --- Access -----------------------------------------------------------------
# The first account created becomes the admin. After that, only admins can add
# users unless this is true.
ALLOW_SIGNUP=false

# Your household's time zone (used for feeds that do not specify one).
DEFAULT_TIMEZONE=America/Chicago

# --- Networking -------------------------------------------------------------
# Port on the Ubuntu host for plain HTTP.
APP_PORT=8080
# 0.0.0.0 = reachable on your LAN. Use 127.0.0.1 when running behind Caddy/nginx.
APP_BIND=0.0.0.0
# Domain for the optional Caddy HTTPS profile (docker compose --profile https up -d)
DOMAIN=calendar.example.com
# Token for the optional Cloudflare Tunnel profile (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
# Force Secure cookies (defaults to on when BASE_URL starts with https://)
# COOKIE_SECURE=true

# --- Sync -------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=15
# Refuse calendar URLs on private networks (set true if strangers can sign up).
BLOCK_PRIVATE_NETWORKS=false

# --- Backups ----------------------------------------------------------------
# Nightly database dumps are written to ./backups on the server.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=14

# --- Email (optional) -------------------------------------------------------
# Easiest: leave these blank and set email up in the app under Settings → Email.
# These are only a fallback, used when nothing has been saved there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Local hour (DEFAULT_TIMEZONE) when morning summaries are sent.
DIGEST_HOUR=7

# --- Google Calendar (optional) --------------------------------------------
# See README → "Linking Google". Redirect URI must be BASE_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
