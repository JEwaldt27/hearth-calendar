{
  "name": "Hearth Calendar",
  "short_name": "Hearth",
  "description": "Your family calendar, chores and lists.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf6f0",
  "theme_color": "#e0763b",
  "icons": [
